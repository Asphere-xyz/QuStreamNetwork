# Database
DB_NAME=staking
DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5433

START_BLOCK=0

# GraphQL
GQL_PORT=4350

# Moonbeam Configuration
# CHAIN=moonbeam
# CHAIN_RPC_ENDPOINT=https://rpc.api.moonbeam.network
# TOKEN_SYMBOL=GLMR
# TOKEN_DECIMALS=18
# SS58_PREFIX=1284

# QuStream zombienet configuration
CHAIN=qustream
CHAIN_RPC_ENDPOINT=ws://127.0.0.1:8800
TOKEN_SYMBOL=QSTG
TOKEN_DECIMALS=18
SS58_PREFIX=5041
QUSTREAM_CONTRACT_ADDRESS=

CONNECTION_STRING=postgresql://postgres:postgres@localhost:5433/staking

# Performance tuning (optional, defaults shown)
# RPC_RATE_LIMIT=1000
# MAX_BATCH_CALL_SIZE=10000
