# Example .env file for DeployQuStreamRequestManager.s.sol
# Copy this file to .env and fill in your values

PRIVATE_KEY=0xYourDeployerPrivateKey
CONTRACT_OWNER=0xYourContractOwnerAddress
QUSTREAM_FEE_OWNER=0xYourQuStreamFeeOwnerAddress
ENCRYPTION_NODE_FEE_OWNER=0xYourEncryptionNodeFeeOwnerAddress
MASTER_NODE=0xYourMasterNodeAddress
USER_FEE=10000000000000000  # 0.01 ETH in wei
QUSTREAM_FEE_PERCENTAGE=40  # 40%